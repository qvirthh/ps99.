local ORB_ZONES = {
    [1] = "1 | Ember Cliffs",
    [2] = "2 | Spore Forest",
    [3] = "3 | Green Graveyard",
    [4] = "4 | Witching Hour",
}
local CLAIM_DISTANCE = 5
local MOVE_TIMEOUT = 15
local STUCK_CHECK_TIME = 1.5
local GLIDE_SPEED = 90
local MAX_ATTEMPTS = 3

local orbAttempts = {}
local zoneBounds = {}
local orbZoneNumber = nil
local orbZoneInstance = nil
local useGlide = false
local lastStatus = ""
local statusLabel

local function setStatus(text)
    if statusLabel then statusLabel.Text = "Orb: " .. text end
    if text ~= lastStatus then
        lastStatus = text
        log("Orb:", text)
    end
end

local function orbActive(myRun)
    return alive() and C.orb and C._orbRun == myRun
end

local function findZone(zoneRoot, number)
    local exactName = ORB_ZONES[number]
    if not zoneRoot or not exactName then return nil end

    local zone = zoneRoot:FindFirstChild(exactName)
    if zone then return zone end

    for _, child in ipairs(zoneRoot:GetChildren()) do
        if tonumber(child.Name:match("^%s*(%d+)")) == number then
            return child
        end
    end
    return nil
end

local function getBounds(instance)
    local minV, maxV

    local function addPart(part)
        local cf = part.CFrame
        local size = part.Size
        local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector

        local half = Vector3.new(
            math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(look.X) * size.Z,
            math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(look.Y) * size.Z,
            math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(look.Z) * size.Z
        ) * 0.5

        local pMin = cf.Position - half
        local pMax = cf.Position + half

        minV = minV and minV:Min(pMin) or pMin
        maxV = maxV and maxV:Max(pMax) or pMax
    end

    if instance:IsA("BasePart") then addPart(instance) end
    for _, d in ipairs(instance:GetDescendants()) do
        if d:IsA("BasePart") then addPart(d) end
    end
    return minV, maxV
end

local function refreshZoneBounds()
    table.clear(zoneBounds)
    local zoneRoot = getZoneRoot()
    if not zoneRoot then return end

    for number in pairs(ORB_ZONES) do
        local zone = findZone(zoneRoot, number)
        if zone then
            local minV, maxV = getBounds(zone)
            if minV and maxV then
                zoneBounds[number] = { min = minV, max = maxV, center = (minV + maxV) * 0.5 }
            end
        end
    end
end

local function distanceToBox(point, box)
    local dx = math.max(box.min.X - point.X, 0, point.X - box.max.X)
    local dy = math.max(box.min.Y - point.Y, 0, point.Y - box.max.Y)
    local dz = math.max(box.min.Z - point.Z, 0, point.Z - box.max.Z)
    return Vector3.new(dx, dy, dz).Magnitude
end

local function getZoneNumberAt(position)
    local bestNumber, bestBoxDistance, bestCenterDistance = nil, math.huge, math.huge

    for number, box in pairs(zoneBounds) do
        local boxDistance = distanceToBox(position, box)
        local centerDistance = (position - box.center).Magnitude

        if boxDistance < bestBoxDistance - 0.001
            or (math.abs(boxDistance - bestBoxDistance) <= 0.001 and centerDistance < bestCenterDistance) then
            bestNumber = number
            bestBoxDistance = boxDistance
            bestCenterDistance = centerDistance
        end
    end
    return bestNumber
end

local function getOrbPart(orbContainer)
    if orbContainer:IsA("BasePart") then return orbContainer end
    local orb = orbContainer:FindFirstChild("Orb", true)
    if orb and orb:IsA("BasePart") then return orb end
    return orbContainer:FindFirstChildWhichIsA("BasePart", true)
end

local function getOrbId(orbContainer)
    return tonumber(orbContainer.Name:match("%d+"))
end

local function isOrbInSelectedZone(orbContainer, orbPart)
    if orbZoneInstance and orbZoneInstance.Parent and orbZoneInstance:IsAncestorOf(orbContainer) then
        return true
    end
    return getZoneNumberAt(orbPart.Position) == orbZoneNumber
end

local function getNearestOrb()
    local character = lp.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local orbFolder = getOrbFolder()

    if not rootPart or not orbFolder then return nil, nil, 0, 0 end

    local nearestContainer, nearestPart = nil, nil
    local nearestDistance = math.huge
    local total, inZone = 0, 0
    local present = {}

    for _, orbContainer in ipairs(orbFolder:GetChildren()) do
        local id = getOrbId(orbContainer)
        local orbPart = getOrbPart(orbContainer)

        if id and orbPart then
            present[id] = true
            total += 1

            if isOrbInSelectedZone(orbContainer, orbPart) then
                inZone += 1

                if (orbAttempts[id] or 0) < MAX_ATTEMPTS then
                    local distance = (rootPart.Position - orbPart.Position).Magnitude
                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestContainer = orbContainer
                        nearestPart = orbPart
                    end
                end
            end
        end
    end

    for id in pairs(orbAttempts) do
        if not present[id] then orbAttempts[id] = nil end
    end

    return nearestContainer, nearestPart, inZone, total
end

local function flatDistance(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function moveToOrb(orbPart, myRun)
    local character = lp.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then
        task.wait(0.5)
        return false
    end

    local bindName = "QvirthhOrbMove" .. tostring(myRun)
    local reached = false

    RunService:BindToRenderStep(bindName, Enum.RenderPriority.Character.Value + 1, function(dt)
        if not orbActive(myRun) or not orbPart.Parent or not rootPart.Parent then return end

        local offset = orbPart.Position - rootPart.Position
        local flat = Vector3.new(offset.X, 0, offset.Z)

        if flat.Magnitude <= CLAIM_DISTANCE then
            reached = true
            humanoid:Move(Vector3.zero, false)
            return
        end

        if useGlide then
            local step = math.min(GLIDE_SPEED * dt, offset.Magnitude)
            rootPart.CFrame = rootPart.CFrame + offset.Unit * step
        else
            humanoid:Move(flat.Unit, false)
        end
    end)

    local startTime = os.clock()
    local checkTime = startTime
    local checkDistance = flatDistance(rootPart.Position, orbPart.Position)

    while orbActive(myRun) and orbPart.Parent and rootPart.Parent and not reached do
        local now = os.clock()
        if now - startTime >= MOVE_TIMEOUT then break end

        if not useGlide and now - checkTime >= STUCK_CHECK_TIME then
            local distance = flatDistance(rootPart.Position, orbPart.Position)
            if checkDistance - distance < 3 then
                useGlide = true
                log("Orb: humanoid movement isn't moving the hoverboard, switching to glide mode")
            end
            checkTime = now
            checkDistance = distance
        end

        task.wait()
    end

    pcall(function() RunService:UnbindFromRenderStep(bindName) end)
    humanoid:Move(Vector3.zero, false)

    return reached
end

local function claimOrb(id)
    task.spawn(function()
        local ok, result = pcall(function()
            local net = RS:FindFirstChild("Network")
            local remote = net and net:FindFirstChild("Instancing_InvokeCustomFromClient")
            return remote and remote:InvokeServer("HatchWar", "HW_Orbs_Claim", id)
        end)
        log("Orb: claimed", id, ok, result)
    end)
end

local function orbWorker(myRun)
    task.wait(0.5)
    local lastRefresh = 0

    while orbActive(myRun) do
        if orbZoneNumber ~= C.orbZone then
            orbZoneNumber = C.orbZone
            orbAttempts = {}
            orbZoneInstance = nil
            lastRefresh = 0
        end

        if os.clock() - lastRefresh >= 10 or next(zoneBounds) == nil then
            refreshZoneBounds()
            orbZoneInstance = findZone(getZoneRoot(), orbZoneNumber)
            lastRefresh = os.clock()
        end

        if next(zoneBounds) == nil then
            setStatus("HatchWar zones not found - waiting for the event...")
            task.wait(1)
        else
            local orbContainer, orbPart, inZone, total = getNearestOrb()

            if orbContainer and orbPart then
                local id = getOrbId(orbContainer)
                orbAttempts[id] = (orbAttempts[id] or 0) + 1

                setStatus(("zone %d | %d orbs in zone (%d total)"):format(orbZoneNumber, inZone, total))

                local reached = moveToOrb(orbPart, myRun)
                if reached and orbActive(myRun) then
                    claimOrb(id)
                    task.wait(0.15)
                end
            else
                setStatus(("zone %d | waiting for orbs (%d in zone, %d total)"):format(orbZoneNumber, inZone, total))
                task.wait(0.25)
            end
        end

        task.wait(0.05)
    end
end

local function stopHumanoid()
    local character = lp.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:Move(Vector3.zero, false) end
end

local function startOrb()
    orbAttempts = {}
    useGlide = false
    orbZoneNumber = C.orbZone
    orbZoneInstance = findZone(getZoneRoot(), orbZoneNumber)

    C._orbRun = (C._orbRun or 0) + 1
    local myRun = C._orbRun

    fireNetwork("Hoverboard_RequestEquip")
    setStatus("started - " .. ORB_ZONES[orbZoneNumber])
    task.spawn(orbWorker, myRun)
end

local function stopOrb()
    C._orbRun = (C._orbRun or 0) + 1
    fireNetwork("Hoverboard_RequestUnequip")
    stopHumanoid()
    setStatus("stopped")
end

